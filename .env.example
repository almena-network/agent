# Almena Agent configuration. `task init` copies this file to .env, which the
# agent (pydantic-settings), Docker Compose and Task all read.

# development | production | test. `production` hides /docs and /openapi.json.
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO

# Port published on the host by Docker Compose (the agent listens on 8100 inside).
AGENT_PORT=8100

# Domain the agent is deployed at: the site and certificate of Caddy
# (Caddyfile, `task up`). Its DNS name must point at this machine. Docker
# Compose and Caddy read it; the agent itself does not.
AGENT_DOMAIN=agent.almena.id

# Cloudflare API token for Caddy's Let's Encrypt certificate (DNS-01): Zone /
# DNS / Edit on the domain's zone.
CLOUDFLARE_API_TOKEN=

# Public origin of the agent, https://{AGENT_DOMAIN} behind Caddy. The agent card (/.well-known/agent-card.json)
# advertises its A2A endpoints under it: {AGENT_PUBLIC_URL}/a2a/jsonrpc and
# {AGENT_PUBLIC_URL}/a2a/rest. For a local-only setup: http://localhost:8100
AGENT_PUBLIC_URL=https://agent.almena.id

# How the agent card names the agent and who runs it.
AGENT_NAME=Almena Agent
AGENT_DESCRIPTION=The AI agent of Almena ID.
AGENT_PROVIDER_ORGANIZATION=Almena ID
AGENT_PROVIDER_URL=https://almena.id

# Claude. The Anthropic SDK reads the key itself; with it empty, `task dev`
# falls back to an `ant auth login` profile.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: how hard Claude thinks, and so its cost.
AGENT_EFFORT=high
AGENT_MAX_TOKENS=64000
# Replaces the built-in system prompt (src/almena_agent/prompts.py) when set.
AGENT_SYSTEM_PROMPT=
# Exchanges a conversation (A2A context) holds before the peer must start a new one.
AGENT_HISTORY_TURNS=50

# The registry API's MCP endpoint. Every caller sends its registry token
# (Authorization: Bearer almena_…) and gets its tools, acting as its account;
# empty turns the tools off. For the API's `task dev`: http://localhost:8000/mcp
AGENT_REGISTRY_MCP_URL=https://api.almena.id/mcp
# Rounds of tool calls one reply may take before it must answer.
AGENT_MAX_TOOL_ROUNDS=20

# The registry API's signed-in account. Every A2A call needs a token it accepts
# (the agent card does not); without one Claude never runs. Required.
# For the API's `task dev`: http://localhost:8000/api/v1/auth/me
AGENT_REGISTRY_ACCOUNT_URL=https://api.almena.id/api/v1/auth/me
# Seconds an accepted token is trusted before the API is asked again.
AGENT_TOKEN_CACHE_SECONDS=60
# Per window of AGENT_RATE_LIMIT_WINDOW_SECONDS: A2A calls per account, and
# refused tokens per client IP (past it, the address waits out the window).
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RATE_LIMIT=30
AGENT_AUTH_FAILURE_LIMIT=10
# Conversations kept in memory: dropped once idle this many minutes, and the
# least recently used beyond this many.
AGENT_CONVERSATION_IDLE_MINUTES=60
AGENT_MAX_CONVERSATIONS=1000
# Finished tasks (completed, failed, canceled, rejected) kept in memory:
# dropped once idle this many minutes, and the least recently used beyond this
# many tasks in all. Tasks still in flight are never dropped.
AGENT_TASK_IDLE_MINUTES=60
AGENT_MAX_TASKS=5000

# Prometheus metrics (GET /metrics) on their own address, host:port, never on
# the public app nor through Caddy; empty: off. In Docker, 0.0.0.0:9090 and
# scrape it from the Compose network (it is not published).
# AGENT_METRICS_ADDR=127.0.0.1:9090
AGENT_METRICS_ADDR=
